{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Milano Iso tiles.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version", "crs", "origin", "tile_size_m", "axis", "quantization", "layers",
    "attribution", "tiles", "totals", "instanced_layers", "index", "minimap"
  ],
  "properties": {
    "format_version": {"const": 1},
    "crs": {"const": "EPSG:32632"},
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["e", "n"],
      "properties": {"e": {"type": "number"}, "n": {"type": "number"}}
    },
    "tile_size_m": {"type": "number", "exclusiveMinimum": 0},
    "axis": {"const": "x=E-E0, y=up, z=-(N-N0)"},
    "quantization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_m", "anchor"],
      "properties": {"unit_m": {"const": 0.02}, "anchor": {"const": "tile_center"}}
    },
    "layers": {
      "description": "Layer names of the tileset, in export order. Mesh layers: buildings, landuse, green, water, road_areas, roads, markings, rail, landmark_details (T-4.2: stylised details, every feature table row has stylised = true). Instanced layers (no mesh): see instanced_layers.",
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1
    },
    "instanced_layers": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "attribution": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "licence", "text"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "licence": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1}
        }
      }
    },
    "index": {
      "description": "T-5.3a: search index of named features (index.json).",
      "$ref": "#/$defs/extra_file"
    },
    "minimap": {
      "description": "T-5.3a: minimap drawing of the whole tileset extent (minimap.svg).",
      "$ref": "#/$defs/extra_file"
    },
    "levels": {
      "description": "T-6.2: levels of detail. Level 0 is the base tiles (listed in `tiles`); every other level is a set of coarser blocks with its own `tiles`. A level may be shown where metres per pixel >= tolerance_m.",
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/level"}
    },
    "tiles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/tile"}},
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tiles", "counts", "glb_bytes", "gzip9_bytes", "features_bytes"],
      "properties": {
        "tiles": {"type": "integer", "minimum": 1},
        "counts": {"$ref": "#/$defs/counts"},
        "glb_bytes": {"type": "integer", "minimum": 0},
        "gzip9_bytes": {"type": "integer", "minimum": 0},
        "features_bytes": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "counts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"type": "number"}
    },
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "number"}
    },
    "bbox3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {"min": {"$ref": "#/$defs/vec3"}, "max": {"$ref": "#/$defs/vec3"}}
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "extra_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "bytes", "gzip9_bytes", "sha256"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "gzip9_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "block_m", "tolerance_m", "unit_m"],
      "properties": {
        "level": {"type": "integer", "minimum": 0},
        "block_m": {"type": "number", "exclusiveMinimum": 0},
        "tolerance_m": {"type": "number", "exclusiveMinimum": 0},
        "unit_m": {"type": "number", "exclusiveMinimum": 0},
        "keeps": {"type": "object"},
        "tiles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/tile"}},
        "totals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tiles", "counts", "glb_bytes", "gzip9_bytes", "features_bytes"],
          "properties": {
            "tiles": {"type": "integer", "minimum": 1},
            "counts": {"$ref": "#/$defs/counts"},
            "glb_bytes": {"type": "integer", "minimum": 0},
            "gzip9_bytes": {"type": "integer", "minimum": 0},
            "features_bytes": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "tile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "i", "j", "bbox_local", "bbox_epsg32632", "content_bbox_local", "counts", "glb",
        "features"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^(L[0-9]+_)?-?[0-9]+_-?[0-9]+$"},
        "i": {"type": "integer"},
        "j": {"type": "integer"},
        "bbox_local": {"$ref": "#/$defs/bbox"},
        "bbox_epsg32632": {"$ref": "#/$defs/bbox"},
        "content_bbox_local": {"$ref": "#/$defs/bbox3"},
        "counts": {"$ref": "#/$defs/counts"},
        "glb": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "bytes", "gzip9_bytes", "sha256"],
          "properties": {
            "file": {"type": "string", "pattern": "^(L[0-9]+_)?-?[0-9]+_-?[0-9]+\\.glb$"},
            "bytes": {"type": "integer", "minimum": 0},
            "gzip9_bytes": {"type": "integer", "minimum": 0},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "features": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "bytes", "sha256"],
          "properties": {
            "file": {"type": "string", "pattern": "^(L[0-9]+_)?-?[0-9]+_-?[0-9]+\\.json$"},
            "bytes": {"type": "integer", "minimum": 0},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    }
  }
}
